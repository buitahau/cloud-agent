# Target repository
REPO_URL=git@github.com:your-org/your-repo.git   # or https://... with a token
REPO_BRANCH=dev                                  # branch to pull before every run (main | dev | ...)
WORKSPACE_DIR=./workspace                        # where the repo is cloned

# Git auth (pick one)
GIT_SSH_KEY_PATH=~/.ssh/id_ed25519               # for SSH URLs
# GIT_TOKEN=ghp_xxx                              # for HTTPS URLs

# Claude subscription auth (headless)
# Generate once with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxx

# Claude run options
CLAUDE_PERMISSION_MODE=bypassPermissions         # non-interactive: no one is there to approve tool calls
CLAUDE_MAX_TURNS=50
JOB_TIMEOUT_SECONDS=1800

# Server
PORT=8080
API_KEY=change-me                                # protects the endpoints

# ---------------------------------------------------------------------------
# Optional extras (not in the spec; defaults shown). See docs/IMPLEMENTATION_PLAN.md.
# ---------------------------------------------------------------------------
# CLAUDE_BIN=claude                 # path to the claude binary; tests point this at test-support/fake-claude.js
# CLAUDE_AUTH_PROBE=true            # startup: also run a 1-turn `claude -p` to prove the token really works (needed for T1)
# GIT_TIMEOUT_SECONDS=300           # per git command; exceeding it fails the job (status "failed", not "timeout")
# LOGS_TAIL_LINES=50                # lines returned in logs_tail
