# Encryption key for repo tokens stored in DB_FILE (required). Generate: openssl rand -base64 32
# Keep a copy OUTSIDE your backups (password manager). Losing it = re-enter every token.
MASTER_KEY=
# MASTER_KEY_PREVIOUS=            # old key(s), comma-separated, only while rotating

# Repos and their (encrypted) tokens live in this SQLite database.
DB_FILE=./data/cloud-agent.db
# Each repo is cloned to WORKSPACE_ROOT/<id> on its first job.
WORKSPACE_ROOT=./workspaces
# SSH_KEYS_DIR=/run/ssh-keys        # ssh keys must live here (local dev: ~/.ssh)
# ALLOW_LOCAL_REPOS=false           # allow absolute-path / file:// repos (tests, local dev)

# Repos: add them in the admin dashboard (/admin/ -> Add repo) or the admin API, or import a repos.json into an
# empty database once:  node src/cli.js import repos.json   (see repos.example.json and the README)
# Do NOT set REPOS_FILE, GIT_TOKEN or GIT_TOKEN_* here: the service refuses to start while one is set
# (export the tokens in your shell for the import only).

# Claude auth: nothing to configure here.
# The service uses the Claude subscription already logged in on this machine (run `claude`, then /login,
# once, as the same OS user that runs this service). ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN are
# stripped from claude's environment so that login is always used. API_KEY, ADMIN_PASSWORD, MASTER_KEY and any
# variable holding a stored repo token are stripped too.

# Claude run options
CLAUDE_PERMISSION_MODE=bypassPermissions         # non-interactive: no one is there to approve tool calls
CLAUDE_MAX_TURNS=50
JOB_TIMEOUT_SECONDS=1800

# Server
PORT=8080
API_KEY=change-me                                # protects the API endpoints (x-api-key header)

# Jobs
MAX_CONCURRENT_JOBS=1                            # jobs running at once across repos; never more than 1 per repo
JOBS_FILE=./data/jobs.jsonl                      # keep job history across restarts (unset = in memory only)
JOB_RETENTION_MAX=1000                           # finished jobs kept (memory and JOBS_FILE)

# Admin dashboard at /admin/ (dashboard + repo admin API; HTTP Basic auth; ADMIN_PASSWORD is a write credential,
# use >= 16 chars). Unset ADMIN_PASSWORD = dashboard disabled.
# Must differ from API_KEY. Put TLS in front (reverse proxy) — Basic auth sends the password on every request.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-too

# ---------------------------------------------------------------------------
# Optional extras (not in the spec; defaults shown). See docs/IMPLEMENTATION_PLAN.md.
# ---------------------------------------------------------------------------
# CLAUDE_BIN=claude                 # path to the claude binary; tests point this at test-support/fake-claude.js
# CLAUDE_AUTH_PROBE=true            # startup: also run a 1-turn `claude -p` to prove the login really works (needed for T1)
# GIT_TIMEOUT_SECONDS=300           # per git command; exceeding it fails the job (status "failed", not "timeout")
# LOGS_TAIL_LINES=50                # lines returned in logs_tail
# TRUST_PROXY=false                 # true = trust X-Forwarded-For/-Proto/-Host from a local/private proxy (audit IP, admin CSRF origin check)
